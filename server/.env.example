NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local helper: pnpm db:local. Use your own database name for shared MongoDB.
MONGO_URI=mongodb://127.0.0.1:27018/sharlock_dev

# Generated by pnpm setup:env. Reserved for Step 4 authentication; never commit it.
SESSION_SECRET=replace-with-a-random-64-character-hex-secret

# Test commands generate their own disposable database URI and secret.
# Direct test invocations require an explicit URI whose database ends in _test.
TEST_MONGODB_URI=

# G-SOC LLM adapter (server/src/modules/games/social-engineering-simulator/llm/).
# Local/remote Ollama mode: set both LLM_BASE_URL and LLM_MODEL (replace the
# Gemini model name below with an Ollama model, e.g. llama3.2:1b).
LLM_BASE_URL=
# Default is the Gemini model for the shared team key. gemini-2.5-flash is no
# longer available to new users, so do not rely on the code default.
LLM_MODEL=gemini-3.8-flash

# Optional, Ollama mode only: needed if LLM_BASE_URL sits behind a gateway that
# requires auth (e.g. an nginx reverse proxy in front of a remote Ollama host).
# Sent as `Authorization: Bearer <token>`. Leave empty for an unauthenticated
# local Ollama.
LLM_AUTH_TOKEN=


# Cloud mode (mutually exclusive with Ollama mode). Setting this switches the
# adapter to Gemini. LLM_MODEL alone picks the Gemini model (the code
# default gemini-2.5-flash is retired). If LLM_BASE_URL and LLM_MODEL are both set they are ignored.
LLM_API_KEY=
