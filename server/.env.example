NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local helper: pnpm db:local. Use your own database name for shared MongoDB.
MONGO_URI=mongodb://127.0.0.1:27018/sharlock_dev

# Generated by pnpm setup:env. Reserved for Step 4 authentication; never commit it.
SESSION_SECRET=replace-with-a-random-64-character-hex-secret

# Test commands generate their own disposable database URI and secret.
# Direct test invocations require an explicit URI whose database ends in _test.
TEST_MONGODB_URI=

# G-SOC LLM adapter (server/src/modules/games/social-engineering-simulator/llm/).
# Local Ollama: set both LLM_BASE_URL and LLM_MODEL, leave LLM_API_KEY empty.
# Cloud fallback: set LLM_API_KEY instead (cloud provider not implemented yet).
# If both are set, LLM_API_KEY wins.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional: only needed if your LLM_BASE_URL sits behind a gateway that requires
# auth (e.g. an nginx reverse proxy in front of a remote Ollama host). Sent as
# `Authorization: Bearer <token>`. Leave empty for an unauthenticated local Ollama.
LLM_AUTH_TOKEN=
