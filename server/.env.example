NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Local helper: pnpm db:local. Use your own database name for shared MongoDB.
MONGO_URI=mongodb://127.0.0.1:27018/sharlock_dev

# Generated by pnpm setup:env. Reserved for Step 4 authentication; never commit it.
SESSION_SECRET=replace-with-a-random-64-character-hex-secret

# Test commands generate their own disposable database URI and secret.
# Direct test invocations require an explicit URI whose database ends in _test.
TEST_MONGODB_URI=

# G-SOC uses TWO LLM roles at once, each with fixed variables:
#   1. Bad actor (the pressuring colleague)  -> always Gemini (cloud, fast).
#      Configured by LLM_API_KEY + LLM_MODEL below.
#   2. Real colleague (the person the player messages to verify the request)
#      -> always Ollama (local/remote, slow). Configured by the
#      LLM_COLLEAGUE_* variables at the bottom of this file.
# The game no longer reads LLM_BASE_URL or LLM_AUTH_TOKEN. They are kept below
# only so older .env files do not look broken; any value in them is ignored.
#
# Bad actor (server/src/modules/games/social-engineering-simulator/llmConfig.js).
# Gemini needs LLM_API_KEY. LLM_MODEL without LLM_API_KEY leaves the bad actor
# unconfigured, and the game then reports that it needs an LLM provider.
LLM_BASE_URL=
# Default is the Gemini model for the shared team key. gemini-2.5-flash is no
# longer available to new users, so do not rely on the code default.
LLM_MODEL=gemini-3.8-flash

# Legacy, ignored by the game (see above). The colleague's gateway token is
# LLM_COLLEAGUE_AUTH_TOKEN at the bottom of this file.
LLM_AUTH_TOKEN=


# Gemini key for the bad actor. LLM_MODEL picks the Gemini model (the code
# default gemini-2.5-flash is retired).
LLM_API_KEY=

# --- Real colleague: Ollama only ---
# The colleague stays on Ollama regardless of LLM_API_KEY, so the Gemini key
# above never reroutes it. LLM_COLLEAGUE_BASE_URL and LLM_COLLEAGUE_MODEL must be
# set together or both left empty (env.js throws otherwise and the whole API
# refuses to start). With both empty the game falls back to the one-click verify
# button.
# Left empty on purpose, so the game works for everyone. The project owner runs a
# shared Ollama VM behind an nginx gateway and shares its address, the model name
# and the token privately; each teammate puts them in their own untracked .env.
# Never commit the address or the token. To use your own Ollama instead, set
# LLM_COLLEAGUE_BASE_URL=http://localhost:11434 and a model you have pulled, such
# as llama3.2:3b-fast, and leave the token empty.
# This is the slow model (3B on 2 vCPU); its speed is the pacing, so no
# artificial delay is added.
LLM_COLLEAGUE_BASE_URL=
LLM_COLLEAGUE_MODEL=
# Sent as `Authorization: Bearer <token>`. Only needed when the Ollama host sits
# behind a gateway that requires it.
LLM_COLLEAGUE_AUTH_TOKEN=
# Timeout for the colleague's reply, in milliseconds. Valid range 1000 to 60000,
# default 60000, because the browser waits 65000 ms. It is applied in
# llmTimeout.js, outside the guarded llm/ folder.
LLM_COLLEAGUE_TIMEOUT_MS=60000
